<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FF000000">


    <ImageView android:id="@+id/dreamAmbient" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" />

    <LinearLayout android:id="@+id/dreamContent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="true">

            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textColor="#E6FFFFFF" android:textSize="156sp" android:fontFamily="@string/font_medium" android:letterSpacing="-0.055" android:includeFontPadding="false" android:id="@+id/standbyClock" />

            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:format12Hour="a" android:format24Hour="" android:textColor="#99FFFFFF" android:textSize="18sp" android:fontFamily="@string/font_medium" android:letterSpacing="0.08" android:textAllCaps="true" android:layout_gravity="bottom" android:layout_marginBottom="24dp" />
        </LinearLayout>

        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginTop="12dp" android:format12Hour="@string/date_format" android:format24Hour="@string/date_format" android:textColor="#A6FFFFFF" android:textSize="18sp" android:fontFamily="@string/font_regular" android:letterSpacing="0.06" android:textAllCaps="false" />
    </LinearLayout>
</FrameLayout>